{
  "config_version": "AEGIS_VISION_1.0",
  "description": "Color configuration for the AEGIS Mobile MT5 Indicator Rulebook Brain. Generated from the standardized 10-image Mobile MT5 template. All colors are stored in RGB with HSV tolerances to accommodate device brightness, compression artifacts, and minor rendering differences.",

  "image_profile": {
    "source": "AEGIS Standard Mobile MT5 Template",
    "validated_images": 10,
    "timeframe": "M1",
    "theme": "Dark",
    "roi_layout": "Fixed",
    "template": "AEGIS Mobile MT5 Standard Indicator Template"
  },

  "color_space": "HSV",

  "global_tolerance": {
    "hue": 10,
    "saturation": 45,
    "value": 45
  },

  "roi": {
