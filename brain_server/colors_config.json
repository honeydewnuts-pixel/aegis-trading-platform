      "top_percent": 0.00,
      "bottom_percent": 0.61
    },
    "indicator_panel": {
      "top_percent": 0.61,
      "bottom_percent": 1.00
    }
  },

  "indicators": {

    "#1": {
      "name": "Bands34",
      "description": "Stationary Bollinger Bands (Period 34, Deviation 1.618)",
      "color_name": "White",
      "rgb": [245, 245, 245],
      "hsv_tolerance": {
        "hue": 12,
        "saturation": 35,
        "value": 40
      }
    },

    "#2": {
      "name": "Bands17",
      "description": "Motional Bollinger Bands (Period 17, Deviation 2.618)",
      "color_name": "BrightGreen",
      "rgb": [0, 255, 0],
      "hsv_tolerance": {
        "hue": 15,
        "saturation": 50,
        "value": 45
      }
    },

    "#3": {
      "name": "WilliamsR60",
      "description": "Williams %R (60)",
      "color_name": "Orange",
      "rgb": [255, 165, 0],
      "hsv_tolerance": {
        "hue": 15,
        "saturation": 55,
        "value": 45
      }
    },

    "#4": {
      "name": "MA7",
      "description": "Moving Average 7",
      "color_name": "Magenta",
      "rgb": [220, 0, 255],
      "hsv_tolerance": {
        "hue": 14,
        "saturation": 50,
        "value": 45
      }
    },

    "#5": {
      "name": "CCI6",
      "description": "Commodity Channel Index (6)",
      "color_name": "Red",
